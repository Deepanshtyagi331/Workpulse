# Application Settings
PROJECT_NAME="WorkPulse"
PROJECT_TAGLINE="Internal Task & Management Dashboard"
VERSION="0.1.0"
DEBUG=True
API_V1_STR="/api/v1"

# Database Configuration (SQLite)
DATABASE_URL="sqlite:///./workpulse.db"

# CORS Settings (Comma-separated list of allowed origins)
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# External API Configuration
EXTERNAL_API_BASE_URL="https://jsonplaceholder.typicode.com"
EXTERNAL_API_TIMEOUT_SECONDS=10

# JWT Authentication
# IMPORTANT: In production, replace JWT_SECRET_KEY with a cryptographically
# secure 256-bit random key. Never commit the real secret to version control.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY="your-256-bit-random-secret-key-here"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480
