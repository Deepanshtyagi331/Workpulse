# WorkPulse - Docker Environment Configuration
# Copy this file to .env and adjust variables as needed for production.

# Application Information
PROJECT_NAME="WorkPulse"
PROJECT_TAGLINE="Internal Task & Management Dashboard"
VERSION="0.1.0"
DEBUG=False
API_V1_STR="/api/v1"

# SQLite Database Location (inside container)
DATABASE_URL="sqlite:////app/data/workpulse.db"

# Allowed CORS Origins (comma-separated)
ALLOWED_ORIGINS="http://localhost,http://localhost:80,http://127.0.0.1,http://127.0.0.1:80,http://localhost:5173"

# JWT Authentication
# Replace with a cryptographically secure 256-bit random key in production:
# python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY="workpulse-dev-secret-key-change-in-production-use-256-bit-random"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# File Upload Settings
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR="/app/uploads"

# External API
EXTERNAL_API_BASE_URL="https://jsonplaceholder.typicode.com"
EXTERNAL_API_TIMEOUT_SECONDS=10
